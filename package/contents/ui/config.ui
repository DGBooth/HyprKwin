<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>HyprKwinConfig</class>
 <widget class="QWidget" name="HyprKwinConfig">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>560</width><height>520</height></rect>
  </property>
  <layout class="QVBoxLayout" name="mainLayout">
   <item>
    <widget class="QTabWidget" name="tabs">
     <property name="currentIndex"><number>0</number></property>
     <widget class="QWidget" name="layoutTab">
      <attribute name="title"><string>Layout</string></attribute>
      <layout class="QFormLayout" name="layoutForm">
       <item row="0" column="0">
        <widget class="QLabel" name="defaultLayoutLabel"><property name="text"><string>Layout:</string></property></widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="kcfg_DefaultLayout">
         <property name="toolTip"><string>The layout new workspaces use. Each workspace can be switched separately with the "Next layout" shortcut (Meta+Shift+J by default).</string></property>
         <item><property name="text"><string>Dwindle (Hyprland's default: each window splits the last)</string></property></item>
         <item><property name="text"><string>Master (a master area beside a stack)</string></property></item>
         <item><property name="text"><string>Monocle (one window at a time, full size)</string></property></item>
         <item><property name="text"><string>Scrolling (a strip of columns you scroll through)</string></property></item>
        </widget>
       </item>
       <item row="1" column="0">
        <widget class="QLabel" name="gapsInLabel"><property name="text"><string>Inner gaps (gaps_in):</string></property></widget>
       </item>
       <item row="1" column="1">
        <widget class="QSpinBox" name="kcfg_GapsIn">
         <property name="suffix"><string> px</string></property>
         <property name="maximum"><number>200</number></property>
         <property name="toolTip"><string>Space around each window. Two neighbouring windows are twice this apart, like Hyprland.</string></property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="gapsOutLabel"><property name="text"><string>Outer gaps (gaps_out):</string></property></widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="kcfg_GapsOut">
         <property name="suffix"><string> px</string></property>
         <property name="maximum"><number>400</number></property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="splitRatioLabel"><property name="text"><string>Default split ratio:</string></property></widget>
       </item>
       <item row="3" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_SplitRatio">
         <property name="minimum"><double>0.1</double></property>
         <property name="maximum"><double>1.9</double></property>
         <property name="singleStep"><double>0.05</double></property>
         <property name="decimals"><number>3</number></property>
         <property name="toolTip"><string>dwindle:default_split_ratio. 1.0 is an even split; the first (left/top) window gets ratio / 2.</string></property>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="multiplierLabel"><property name="text"><string>Split width multiplier:</string></property></widget>
       </item>
       <item row="4" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_SplitWidthMultiplier">
         <property name="minimum"><double>0.1</double></property>
         <property name="maximum"><double>4.0</double></property>
         <property name="singleStep"><double>0.1</double></property>
         <property name="toolTip"><string>dwindle:split_width_multiplier. Values above 1 favour side-by-side splits.</string></property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="forceSplitLabel"><property name="text"><string>New window goes:</string></property></widget>
       </item>
       <item row="5" column="1">
        <widget class="QComboBox" name="kcfg_ForceSplit">
         <property name="toolTip"><string>dwindle:force_split</string></property>
         <item><property name="text"><string>Towards the mouse cursor</string></property></item>
         <item><property name="text"><string>Left / top</string></property></item>
         <item><property name="text"><string>Right / bottom</string></property></item>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="kcfg_PreserveSplit">
         <property name="text"><string>Preserve split direction when tiles change size (preserve_split)</string></property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="kcfg_NoGapsWhenOnly">
         <property name="text"><string>No gaps or border when a window is alone</string></property>
        </widget>
       </item>
       <item row="8" column="0">
        <widget class="QLabel" name="resizeStepLabel"><property name="text"><string>Keyboard resize step:</string></property></widget>
       </item>
       <item row="8" column="1">
        <widget class="QSpinBox" name="kcfg_ResizeStep">
         <property name="suffix"><string> px</string></property>
         <property name="minimum"><number>5</number></property>
         <property name="maximum"><number>1000</number></property>
        </widget>
       </item>
       <item row="9" column="1">
        <widget class="QCheckBox" name="kcfg_SlideDivider">
         <property name="text"><string>Slide the split when resizing from the keyboard</string></property>
         <property name="toolTip"><string>The divider slides over a fifth of a second, and each app still resizes only once: the one that grows straight away, the one that shrinks as soon as the divider has passed. Needs the "HyprKwin animations" desktop effect; turn this off if you do not use it. Off: the divider jumps.</string></property>
        </widget>
       </item>
       <item row="10" column="0">
        <widget class="QLabel" name="masterFactorLabel"><property name="text"><string>Master area size:</string></property></widget>
       </item>
       <item row="10" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_MasterFactor">
         <property name="minimum"><double>0.05</double></property>
         <property name="maximum"><double>0.95</double></property>
         <property name="singleStep"><double>0.05</double></property>
         <property name="toolTip"><string>master:mfact. The share of the screen the master area takes, adjustable per workspace with the resize keys.</string></property>
        </widget>
       </item>
       <item row="11" column="0">
        <widget class="QLabel" name="masterCountLabel"><property name="text"><string>Master windows:</string></property></widget>
       </item>
       <item row="11" column="1">
        <widget class="QSpinBox" name="kcfg_MasterCount">
         <property name="minimum"><number>1</number></property>
         <property name="maximum"><number>9</number></property>
         <property name="toolTip"><string>How many windows share the master area (Meta+&gt; and Meta+&lt; change it per workspace).</string></property>
        </widget>
       </item>
       <item row="12" column="0">
        <widget class="QLabel" name="masterOrientationLabel"><property name="text"><string>Master area:</string></property></widget>
       </item>
       <item row="12" column="1">
        <widget class="QComboBox" name="kcfg_MasterOrientation">
         <property name="toolTip"><string>master:orientation. "Centre" puts the master in the middle with the other windows either side, the three-column layout.</string></property>
         <item><property name="text"><string>Left</string></property></item>
         <item><property name="text"><string>Right</string></property></item>
         <item><property name="text"><string>Top</string></property></item>
         <item><property name="text"><string>Bottom</string></property></item>
         <item><property name="text"><string>Centre</string></property></item>
        </widget>
       </item>
       <item row="14" column="0">
        <widget class="QLabel" name="columnWidthLabel"><property name="text"><string>Column width:</string></property></widget>
       </item>
       <item row="14" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_ColumnWidth">
         <property name="minimum"><double>0.1</double></property>
         <property name="maximum"><double>1.0</double></property>
         <property name="singleStep"><double>0.05</double></property>
         <property name="toolTip"><string>The share of the screen each column takes in the scrolling layout. Only whole columns are shown; the rest wait off-screen, and the resize keys widen or narrow the focused column.</string></property>
        </widget>
       </item>
       <item row="15" column="1">
        <widget class="QCheckBox" name="kcfg_LayoutOsd">
         <property name="text"><string>Show a message when the layout or split changes</string></property>
         <property name="toolTip"><string>A short on-screen message naming the new layout, or which way a window just split, on the monitor you are using.</string></property>
        </widget>
       </item>
       <item row="13" column="1">
        <widget class="QCheckBox" name="kcfg_MasterNewIsMaster">
         <property name="text"><string>New windows become the master</string></property>
         <property name="toolTip"><string>master:new_status. Off: a new window joins the end of the stack.</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="appearanceTab">
      <attribute name="title"><string>Appearance</string></attribute>
      <layout class="QFormLayout" name="appearanceForm">
       <item row="0" column="0">
        <widget class="QLabel" name="focusIndicatorLabel"><property name="text"><string>Focused window shown by:</string></property></widget>
       </item>
       <item row="0" column="1">
        <widget class="QComboBox" name="kcfg_FocusIndicator">
         <property name="toolTip"><string>KWin can only turn a window's whole decoration on or off. Letting the decoration do it needs no overlay windows at all; with a frame-only Aurorae theme such as "Active Accent Frame" you get a coloured border and no title bar.</string></property>
         <item><property name="text"><string>The window decoration (no overlays)</string></property></item>
         <item><property name="text"><string>Coloured border, title bars hidden</string></property></item>
         <item><property name="text"><string>Nothing, title bars hidden</string></property></item>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QCheckBox" name="kcfg_BorderOnUndecorated">
         <property name="text"><string>With decorations, still draw a border on apps that decorate themselves</string></property>
         <property name="toolTip"><string>Chromium, Electron and GTK apps draw their own frames on Wayland, so a window decoration theme cannot mark them as focused. This fills the gap for those windows only.</string></property>
        </widget>
       </item>
       <item row="2" column="0">
        <widget class="QLabel" name="borderSizeLabel"><property name="text"><string>Border size:</string></property></widget>
       </item>
       <item row="2" column="1">
        <widget class="QSpinBox" name="kcfg_BorderSize">
         <property name="suffix"><string> px</string></property>
         <property name="maximum"><number>20</number></property>
         <property name="toolTip"><string>Drawn in the gap around tiled windows; only used with the "Coloured border" option above.</string></property>
        </widget>
       </item>
       <item row="11" column="0">
        <widget class="QLabel" name="borderRadiusLabel"><property name="text"><string>Corner radius:</string></property></widget>
       </item>
       <item row="11" column="1">
        <widget class="QSpinBox" name="kcfg_BorderRadius">
         <property name="suffix"><string> px</string></property>
         <property name="maximum"><number>40</number></property>
         <property name="toolTip"><string>decoration:rounding. Rounds the focus border itself; the window's own corners stay square unless your decoration theme rounds them.</string></property>
        </widget>
       </item>
       <item row="12" column="1">
        <widget class="QCheckBox" name="kcfg_HideFloatingTitleBars">
         <property name="text"><string>Hide title bars on floating windows too</string></property>
         <property name="toolTip"><string>Removes the title bar, and with it the minimise/maximise/close buttons, from floating windows as well as tiled ones; they then get the border instead. Apps that draw their own title bar (Chromium, Electron, GTK) always get the border.</string></property>
        </widget>
       </item>
       <item row="13" column="0">
        <widget class="QLabel" name="activeOpacityLabel"><property name="text"><string>Focused window opacity:</string></property></widget>
       </item>
       <item row="13" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_ActiveOpacity">
         <property name="minimum"><double>0.1</double></property>
         <property name="maximum"><double>1.0</double></property>
         <property name="singleStep"><double>0.05</double></property>
         <property name="toolTip"><string>decoration:active_opacity. At 1.00 HyprKwin leaves window opacity alone, so Plasma's own opacity rules still apply. Fullscreen windows always stay opaque.</string></property>
        </widget>
       </item>
       <item row="14" column="0">
        <widget class="QLabel" name="inactiveOpacityLabel"><property name="text"><string>Unfocused window opacity:</string></property></widget>
       </item>
       <item row="14" column="1">
        <widget class="QDoubleSpinBox" name="kcfg_InactiveOpacity">
         <property name="minimum"><double>0.1</double></property>
         <property name="maximum"><double>1.0</double></property>
         <property name="singleStep"><double>0.05</double></property>
         <property name="toolTip"><string>decoration:inactive_opacity. A window rule "opacity A I" overrides both values for that app.</string></property>
        </widget>
       </item>
       <item row="3" column="0">
        <widget class="QLabel" name="activeSourceLabel"><property name="text"><string>Focused border colour:</string></property></widget>
       </item>
       <item row="3" column="1">
        <widget class="QComboBox" name="kcfg_ActiveBorderSource">
         <property name="toolTip"><string>Following the colour scheme means the border changes with your Plasma theme and accent colour.</string></property>
         <item><property name="text"><string>Accent colour of the colour scheme</string></property></item>
         <item><property name="text"><string>Custom colour</string></property></item>
         <item><property name="text"><string>Gradient (col.active_border with two colours)</string></property></item>
        </widget>
       </item>
       <item row="4" column="0">
        <widget class="QLabel" name="activeColorLabel"><property name="text"><string>Custom focused colour:</string></property><property name="toolTip"><string>The colour of the focused border, or where its gradient starts.</string></property></widget>
       </item>
       <item row="4" column="1">
        <widget class="KColorButton" name="kcfg_ActiveBorderColor"/>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="activeColor2Label"><property name="text"><string>Gradient end colour:</string></property></widget>
       </item>
       <item row="5" column="1">
        <widget class="KColorButton" name="kcfg_ActiveBorderColor2">
         <property name="toolTip"><string>Only used with the gradient: the focused border runs from the custom colour above to this one, like Hyprland's default rgba(33ccffee) rgba(00ff99ee) 45deg.</string></property>
        </widget>
       </item>
       <item row="6" column="0">
        <widget class="QLabel" name="gradientAngleLabel"><property name="text"><string>Gradient angle:</string></property></widget>
       </item>
       <item row="6" column="1">
        <widget class="QSpinBox" name="kcfg_BorderGradientAngle">
         <property name="suffix"><string>°</string></property>
         <property name="maximum"><number>359</number></property>
         <property name="wrapping"><bool>true</bool></property>
         <property name="toolTip"><string>0° runs left to right, 90° top to bottom, 45° from the top-left corner to the bottom-right one.</string></property>
        </widget>
       </item>
       <item row="16" column="0">
        <widget class="QLabel" name="gradientSpinLabel"><property name="text"><string>Gradient rotation:</string></property></widget>
       </item>
       <item row="16" column="1">
        <widget class="QSpinBox" name="kcfg_BorderGradientSpin">
         <property name="suffix"><string>°/s</string></property>
         <property name="maximum"><number>720</number></property>
         <property name="toolTip"><string>Hyprland's borderangle animation: the gradient turns around the focused window's border. 0 keeps it still. Anything above 0 redraws the border continuously, which costs a little power.</string></property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="kcfg_ShowInactiveBorders">
         <property name="text"><string>Draw borders around unfocused tiled windows too</string></property>
        </widget>
       </item>
       <item row="8" column="0">
        <widget class="QLabel" name="inactiveSourceLabel"><property name="text"><string>Unfocused border colour:</string></property></widget>
       </item>
       <item row="8" column="1">
        <widget class="QComboBox" name="kcfg_InactiveBorderSource">
         <item><property name="text"><string>Dimmed colour of the colour scheme</string></property></item>
         <item><property name="text"><string>Custom colour</string></property></item>
        </widget>
       </item>
       <item row="9" column="0">
        <widget class="QLabel" name="inactiveColorLabel"><property name="text"><string>Custom unfocused colour:</string></property></widget>
       </item>
       <item row="9" column="1">
        <widget class="KColorButton" name="kcfg_InactiveBorderColor"/>
       </item>
       <item row="10" column="0">
        <widget class="QLabel" name="groupBarLabel"><property name="text"><string>Group tab bar height:</string></property></widget>
       </item>
       <item row="10" column="1">
        <widget class="QSpinBox" name="kcfg_GroupBarHeight">
         <property name="suffix"><string> px</string></property>
         <property name="minimum"><number>12</number></property>
         <property name="maximum"><number>60</number></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="behaviourTab">
      <attribute name="title"><string>Behaviour</string></attribute>
      <layout class="QFormLayout" name="behaviourForm">
       <item row="0" column="1">
        <widget class="QCheckBox" name="kcfg_FocusFollowsMouse">
         <property name="text"><string>Focus follows mouse (like follow_mouse = 1)</string></property>
         <property name="toolTip"><string>Leave this off if you use Plasma's own "Focus follows mouse" policy.</string></property>
        </widget>
       </item>
       <item row="1" column="1">
        <widget class="QCheckBox" name="kcfg_StartOnFirstDesktop">
         <property name="text"><string>Start each session on workspace 1</string></property>
         <property name="toolTip"><string>Plasma otherwise restores whichever workspace you logged out from.</string></property>
        </widget>
       </item>
       <item row="2" column="1">
        <widget class="QCheckBox" name="kcfg_AutoCreateDesktops">
         <property name="text"><string>Create virtual desktops on demand when switching to workspace N</string></property>
        </widget>
       </item>
       <item row="3" column="1">
        <widget class="QCheckBox" name="kcfg_DragToRetile">
         <property name="text"><string>Dropping a dragged window on another one re-tiles it there</string></property>
         <property name="toolTip"><string>Turn off to have dragged windows snap back to their own tile instead.</string></property>
        </widget>
       </item>
       <item row="4" column="1">
        <widget class="QCheckBox" name="kcfg_TileDialogs">
         <property name="text"><string>Tile dialogs and utility windows as well</string></property>
         <property name="toolTip"><string>Off by default: dialogs usually want to float above the window they belong to. Modal dialogs always float.</string></property>
        </widget>
       </item>
       <item row="5" column="0">
        <widget class="QLabel" name="specialMarginLabel"><property name="text"><string>Scratchpad margin:</string></property></widget>
       </item>
       <item row="5" column="1">
        <widget class="QSpinBox" name="kcfg_SpecialMargin">
         <property name="suffix"><string> px</string></property>
         <property name="maximum"><number>500</number></property>
        </widget>
       </item>
       <item row="6" column="1">
        <widget class="QCheckBox" name="kcfg_PerOutputWorkspaces">
         <property name="text"><string>Give every monitor its own workspaces (like Hyprland)</string></property>
         <property name="toolTip"><string>Switching workspace then only changes the monitor you are on, and the others keep what they are showing. Off: a workspace spans every monitor, the way Plasma's virtual desktops normally work.</string></property>
        </widget>
       </item>
       <item row="7" column="1">
        <widget class="QCheckBox" name="kcfg_FocusOnActivate">
         <property name="text"><string>Go to a window that asks to be activated (focus_on_activate)</string></property>
         <property name="toolTip"><string>Launching an app that is already open on another workspace switches to it. Chat apps ask for attention the same way when a message arrives; add a rule such as "focusonactivate off, class:^(discord)$" to stop one pulling you over.</string></property>
        </widget>
       </item>
       <item row="8" column="1">
        <widget class="QCheckBox" name="kcfg_FocusNeighbourOnClose">
         <property name="text"><string>Closing a window focuses the neighbour that takes its place</string></property>
         <property name="toolTip"><string>As in Hyprland: focus follows the window that grows into the gap — the other side of the split, or the next tab in a group. Off: Plasma decides, which means the window you used longest ago, wherever it happens to be.</string></property>
        </widget>
       </item>
       <item row="9" column="0">
        <widget class="QLabel" name="scratchpadNamesLabel"><property name="text"><string>Extra scratchpads:</string></property></widget>
       </item>
       <item row="9" column="1">
        <widget class="KEditListWidget" name="kcfg_ScratchpadNames">
         <property name="kcfg_property" stdset="0"><string>items</string></property>
         <property name="kcfg_propertyNotify" stdset="0"><string>2changed()</string></property>
         <property name="toolTip"><string>Named scratchpads, as in Hyprland's special workspaces. The first name here is scratchpad 1, the second scratchpad 2, and so on; give them keys in System Settings &gt; Keyboard &gt; Shortcuts &gt; KWin (HyprKwin: Toggle scratchpad 1...). A window goes into one with the matching "Move window to/from scratchpad" key, or a rule such as "workspace special:music, class:^(spotify)$". Only one scratchpad is on screen at a time.</string></property>
        </widget>
       </item>
       <item row="10" column="1">
        <widget class="QCheckBox" name="kcfg_Debug">
         <property name="text"><string>Debug logging (journalctl --user -f)</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="rulesTab">
      <attribute name="title"><string>Window rules</string></attribute>
      <layout class="QVBoxLayout" name="rulesLayout">
       <item>
        <widget class="QLabel" name="rulesHelp">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="textFormat"><enum>Qt::RichText</enum></property>
         <property name="text"><string>&lt;p&gt;Rules decide how windows open, written the way &lt;tt&gt;hyprland.conf&lt;/tt&gt; writes them: an action, then what to match, e.g. &lt;tt&gt;float, class:^(org\.kde\.kcalc)$&lt;/tt&gt; or &lt;tt&gt;size 800 600, floating:1, class:^(pavucontrol)$&lt;/tt&gt;. The first rule that matches wins, so order matters.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Actions:&lt;/b&gt; float · tile · pseudo · fullscreen · maximize · pin · group · special [name] · workspace N [silent] · workspace special:name · size W H · move X Y · center · monitor N|name · opacity A [I] · noborder · focusonactivate [on|off]&lt;br/&gt;
&lt;b&gt;Match on:&lt;/b&gt; class:… and title:… (regular expressions), floating:1 or floating:0&lt;br/&gt;
Sizes and positions are pixels or a percentage of the monitor; monitors count from 0, or use a name such as DP-2.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Finding an app's class:&lt;/b&gt; in System Settings › Window Management › Window Rules, add a rule and use &lt;i&gt;Detect Window Properties&lt;/i&gt;, then click the window. Rules apply to windows opened after you press Apply.&lt;/p&gt;</string></property>
        </widget>
       </item>
       <item>
        <widget class="KEditListWidget" name="kcfg_WindowRuleList">
         <property name="kcfg_property" stdset="0"><string>items</string></property>
         <property name="kcfg_propertyNotify" stdset="0"><string>2changed()</string></property>
        </widget>
       </item>
      </layout>
     </widget>
     <widget class="QWidget" name="workspaceRulesTab">
      <attribute name="title"><string>Workspace rules</string></attribute>
      <layout class="QVBoxLayout" name="workspaceRulesLayout">
       <item>
        <widget class="QLabel" name="workspaceRulesHelp">
         <property name="wordWrap"><bool>true</bool></property>
         <property name="textFormat"><enum>Qt::RichText</enum></property>
         <property name="text"><string>&lt;p&gt;Rules for the workspaces themselves, written the way &lt;tt&gt;hyprland.conf&lt;/tt&gt; writes them: the workspace number, then what it should do, e.g. &lt;tt&gt;3, monitor:DP-2, default:true&lt;/tt&gt; or &lt;tt&gt;2, layout:master, gapsin:0, gapsout:0&lt;/tt&gt;.&lt;/p&gt;
&lt;p&gt;&lt;b&gt;Properties:&lt;/b&gt; monitor:N|name pins the workspace to a monitor, so switching to it goes there · default:true makes it the workspace that monitor starts on · layout:dwindle|master|monocle|scrolling · gapsin:N and gapsout:N set its gaps&lt;/p&gt;
&lt;p&gt;Monitors count from 0, or use a name such as DP-2 (System Settings › Display and Monitor lists them). A layout set here is the one the workspace starts with; Meta+Shift+J still changes it afterwards.&lt;/p&gt;</string></property>
        </widget>
       </item>
       <item>
        <widget class="KEditListWidget" name="kcfg_WorkspaceRuleList">
         <property name="kcfg_property" stdset="0"><string>items</string></property>
         <property name="kcfg_propertyNotify" stdset="0"><string>2changed()</string></property>
        </widget>
       </item>
      </layout>
     </widget>
    </widget>
   </item>
  </layout>
 </widget>
